NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://campus_care:replace-this-password@127.0.0.1:5432/campus_care
PG_POOL_MAX=10
# Set PG_SSL=true when the PostgreSQL provider requires TLS.
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Optional isolated PostgreSQL database for integration tests.
TEST_DATABASE_URL=postgres://campus_care:replace-this-password@127.0.0.1:5432/campus_care_test
# Optional source database for the explicit MongoDB-to-PostgreSQL import only.
# MONGO_MIGRATION_URI=mongodb://127.0.0.1:27017/source_database
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax

# Used by `npm run seed:admin` to create the first administrator
ADMIN_NAME=Dispensary Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Used by `npm run seed:demo` to create local demonstration accounts
DEMO_STAFF_PASSWORD=replace-with-a-strong-password
DEMO_STUDENT_PASSWORD=replace-with-a-strong-password
