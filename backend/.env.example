NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/public_dispensary_system
# Optional: isolated integration-test database; its database name must contain "test".
TEST_MONGO_URI=mongodb://127.0.0.1:27017/public_dispensary_test
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax

# Optional student welcome emails
EMAIL=
EMAIL_PASSWORD=

# Used by `npm run seed:admin` to create the first administrator
ADMIN_NAME=Dispensary Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Used by `npm run seed:demo` to create local demonstration accounts
DEMO_STAFF_PASSWORD=replace-with-a-strong-password
DEMO_STUDENT_PASSWORD=replace-with-a-strong-password
